// Vercel Edge Middleware – schützt die komplette Seite mit HTTP Basic Auth.
// Läuft am Edge, bevor irgendein Request deine Seite/Dateien erreicht.
// Diese Datei muss im ROOT deines Vercel-Projekts liegen (gleiche Ebene wie
// z.B. deine index.html / vercel.json), nicht in einem Unterordner.

export const config = {
  matcher: '/:path*',
};

export default function middleware(request) {
  const validUser = 'Nils';
  const validPass = 'nekmys-3Kyhsa-hujfaf';
  const expected = 'Basic ' + btoa(`${validUser}:${validPass}`);

  const authHeader = request.headers.get('authorization');

  if (authHeader === expected) {
    // Zugangsdaten korrekt -> Request normal durchlassen
    return;
  }

  // Keine oder falsche Zugangsdaten -> Browser zeigt natives Login-Popup
  return new Response('Zugriff verweigert', {
    status: 401,
    headers: {
      'WWW-Authenticate': 'Basic realm="Schweinerei"',
    },
  });
}
